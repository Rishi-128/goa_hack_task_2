# ============================================================
# RAG Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys.
# All other values have sensible defaults — only override
# what you need to change.
# ============================================================

# ── API Keys ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── STT Provider ─────────────────────────────────────────────
# STT_PROVIDER=sarvam          # Options: sarvam, groq_whisper, elevenlabs
# SARVAM_LANGUAGE_CODE=en-IN   # Options: en-IN, hi-IN, etc.

# ── Dataset ──────────────────────────────────────────────────
# DATASET_NAME=ai4bharat/MSMARCO-XI
# DATASET_SPLIT=validation
# DATASET_LANGUAGES=eng_Latn
# DATASET_SAMPLE_SIZE=10000

# ── Embedding ────────────────────────────────────────────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=256
# NORMALIZE_EMBEDDINGS=true

# ── Chunking ─────────────────────────────────────────────────
# CHUNKING_STRATEGY=passthrough
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# SEMANTIC_THRESHOLD=0.5

# ── Retrieval & Reranking (<200ms Fast Mode) ────────────────
# DENSE_TOP_K=15
# SPARSE_TOP_K=15
# RRF_K=60
# ENABLE_RERANKER=false       # false = Fast-Path RRF (<15ms), true = CrossEncoder (~900ms)
# RERANKER_MODEL=BAAI/bge-reranker-base
# FINAL_TOP_K=3

# ── LLM (Groq LPU Ultra-Fast Generation) ────────────────────
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=250

# ── Query Processing ────────────────────────────────────────
# DEFAULT_QUERY_MODE=normal
# AUTO_REWRITE=true

# ── Guardrails ───────────────────────────────────────────────
# CONFIDENCE_THRESHOLD=-5.0
# OFFTOPIC_THRESHOLD=0.15
# GROUNDING_THRESHOLD=0.3
# MAX_GROUNDING_RETRIES=1

# ── Caching ──────────────────────────────────────────────────
# ENABLE_CACHE=true
# CACHE_MAX_SIZE=1000

# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
